{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flyfishphilo:context:1",
  "title": "Explicitly selected question and materials",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "base", "question", "notes"],
  "properties": {
    "format": {"const": "flyfishPhilo/context-1"},
    "base": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "question": {
      "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^e[1-9][0-9]*$", "not": {"pattern": "[^e0-9]"}},
        "text": {"type": "string", "minLength": 1, "maxLength": 6000, "pattern": "\\S"}
      }
    },
    "notes": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "description": "Distinct event IDs in ascending event order. Each origin is a label, not a claim of truth.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "origin", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^e[1-9][0-9]*$", "not": {"pattern": "[^e0-9]"}},
          "origin": {"enum": ["firsthand", "excerpt", "retelling", "synthetic", "ai"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 6000, "pattern": "\\S"}
        }
      }
    }
  }
}
